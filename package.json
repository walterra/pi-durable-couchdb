{
  "name": "pi-durable-couchdb",
  "version": "0.0.1",
  "description": "Single-owner CouchDB journal storage for Pi Durable",
  "type": "module",
  "license": "MIT",
  "author": "Walter M. Rafelsberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walterra/pi-durable-couchdb.git"
  },
  "homepage": "https://github.com/walterra/pi-durable-couchdb#readme",
  "bugs": {
    "url": "https://github.com/walterra/pi-durable-couchdb/issues"
  },
  "keywords": [
    "pi-durable",
    "couchdb",
    "agent",
    "durable",
    "storage"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs/releasing.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@testcontainers/couchdb": "^12.2.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
